# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git (см. .gitignore).

# Supabase → Settings → API
SUPABASE_URL=https://vnqmlknaiyfjbbjpikfg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Секретный ключ — ТОЛЬКО на сервере, никогда не в браузере.
# Supabase → Settings → API → Секретные ключи → service_role
SUPABASE_SERVICE_KEY=sb_secret_xxx

# Разрешённые источники для CORS (адрес фронтенда, через запятую)
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Порт (Railway сам подставит свой через переменную PORT)
PORT=8000
